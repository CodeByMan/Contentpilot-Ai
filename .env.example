APP_NAME="ContentPilot"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=contentpilot_ai
DB_USERNAME=contentpilot
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true behind HTTPS in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_BASE_URL=
OPENAI_REQUEST_TIMEOUT=30
AI_CONTENT_MODELS=gpt-4o-mini
AI_DEFAULT_CONTENT_MODEL=gpt-4o-mini
AI_IMAGE_MODELS=gpt-image-2
AI_IMAGE_MODEL=gpt-image-2
AI_AUDIO_MODELS=tts-1,tts-1-hd
AI_AUDIO_MODEL=tts-1
AI_AUDIO_VOICES=nova
AI_AUDIO_VOICE=nova
AI_IMAGE_MAX_CHARACTERS=1500
AI_AUDIO_MAX_CHARACTERS=2500
AI_MAX_PROMPT_CHARACTERS=6000
AI_MAX_INPUT_FIELD_CHARACTERS=1500
AI_MAX_OUTPUT_WORDS=800
AI_CHAT_MAX_CHARACTERS=2000
AI_CHAT_MAX_TOKENS=500
AI_CHAT_MAX_WORDS=300
AI_CHAT_HISTORY_MESSAGES=12
AI_RETRY_ATTEMPTS=2
AI_RETRY_DELAY_MS=250
AI_RESERVATION_TTL_MINUTES=10
AI_CONTENT_RATE_LIMIT=6
AI_MEDIA_RATE_LIMIT=3
AI_CHAT_RATE_LIMIT=8
